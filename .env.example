# Polypreneur OS — v1 environment.
# EVERY value here is optional. With none set, the app runs end-to-end on a
# local JSON store with stubbed integrations. Add credentials to light up the
# real backends — no code changes required.

# --- Supabase (Postgres). When set, replaces the local JSON store. -----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# --- Agents (Anthropic). When unset, agents use a local stub. ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Voice-note transcription (Google Speech-to-Text). Reuses the Google
#     service account below (enable the Speech-to-Text API + grant the
#     cloud-platform scope). Unset Google creds => audio notes are queued with a
#     "transcription not configured" note (text notes still work). --------------
GOOGLE_STT_LANGUAGE=en-US

# --- Read integrations. Each is independent; unset = stubbed. ----------------
NOTION_API_KEY=

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=leaos-hq

# Google service account (Calendar + Drive). Escape newlines in the key as \n.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Drive folder watched for dropped voice-note audio files.
DRIVE_WATCH_FOLDER_ID=

# --- Marketing distribution (write). Unset => the Beehiiv channel is stubbed;
#     the "manual" channel (mark-as-exported) always works. --------------------
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
